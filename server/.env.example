# Copie para .env e preencha. Nunca coloque este arquivo no GitHub.

# Token que o app usa para falar com o servidor (gere um longo e aleatório)
FIDUS_APP_TOKEN=troque-por-um-token-longo
FIDUS_USER_NAME=Mike
FIDUS_TIMEZONE=Europe/London

# IA — troque de provedor sem mexer no código
FIDUS_LLM_PROVIDER=anthropic
FIDUS_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Só se a chave pedir: ID do workspace (Console > Settings > Workspaces), começa com wrkspc_
ANTHROPIC_WORKSPACE_ID=

# Alternativa: qualquer API compatível com OpenAI (OpenAI, Mistral, vLLM/Ollama próprio)
# FIDUS_LLM_PROVIDER=openai_compat
# FIDUS_LLM_MODEL=mistral-large-latest
# OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPAT_API_KEY=

# Transcrição local: tiny | base | small | medium | large-v3
FIDUS_WHISPER_MODEL=small

# Google Cloud (OAuth Client ID do tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do servidor (o mesmo cadastrado como redirect no Google)
FIDUS_PUBLIC_BASE_URL=https://api.seudominio.com

# Finanças: suas empresas/carteiras (separadas por vírgula), moeda padrão e países para busca de endereço
FIDUS_BUSINESSES=Pessoal,HomB,Harvest Coffee,Imóveis Portugal
FIDUS_DEFAULT_CURRENCY=GBP
FIDUS_HOME_COUNTRIES=gb,pt,br

# Busca na web (só com Anthropic): 1 liga, 0 desliga
FIDUS_WEB_SEARCH=1
FIDUS_WEB_SEARCH_COUNTRY=GB

# Plano deste servidor (essencial | negocio | premium) e página de assinatura (vazio até existir pagamento)
FIDUS_PLAN=premium
FIDUS_UPGRADE_URL=
