# Copie para .env e preencha. Nunca coloque este arquivo no GitHub.

# Token que o app usa para falar com o servidor (gere um longo e aleatório)
FIDUS_APP_TOKEN=troque-por-um-token-longo
FIDUS_USER_NAME=Mike
FIDUS_TIMEZONE=Europe/London

# IA — troque de provedor sem mexer no código
FIDUS_LLM_PROVIDER=anthropic
FIDUS_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Só se a chave pedir: ID do workspace (Console > Settings > Workspaces), começa com wrkspc_
ANTHROPIC_WORKSPACE_ID=

# Alternativa: qualquer API compatível com OpenAI (OpenAI, Mistral, vLLM/Ollama próprio)
# FIDUS_LLM_PROVIDER=openai_compat
# FIDUS_LLM_MODEL=mistral-large-latest
# OPENAI_COMPAT_BASE_URL=https://api.mistral.ai/v1
# OPENAI_COMPAT_API_KEY=

# Transcrição local: tiny | base | small | medium | large-v3
FIDUS_WHISPER_MODEL=small

# Google Cloud (OAuth Client ID do tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do servidor (o mesmo cadastrado como redirect no Google)
FIDUS_PUBLIC_BASE_URL=https://api.seudominio.com

# Finanças: suas empresas/carteiras (separadas por vírgula), moeda padrão e países para busca de endereço
FIDUS_BUSINESSES=Pessoal,HomB,Harvest Coffee,Imóveis Portugal
FIDUS_DEFAULT_CURRENCY=GBP
FIDUS_HOME_COUNTRIES=gb,pt,br

# Busca na web (só com Anthropic): 1 liga, 0 desliga
FIDUS_WEB_SEARCH=1
FIDUS_WEB_SEARCH_COUNTRY=GB

# Plano deste servidor (essencial | negocio | premium) e página de assinatura (vazio até existir pagamento)
FIDUS_PLAN=premium
FIDUS_UPGRADE_URL=

# Contas de clientes
# Seu e-mail Google: vira administrador ao entrar com o Google
FIDUS_OWNER_EMAIL=michael@homb.io
# 0 = só quem você convidar (aba Clientes); 1 = qualquer um
FIDUS_SIGNUP_OPEN=0
# Plano de quem entra sem convite com plano definido
FIDUS_NEW_USER_PLAN=essencial

# Idioma e país do dono (clientes: vem do celular). País define a moeda dos planos: GB = libra,
# Europa = euro, resto do mundo = dólar.
FIDUS_LANGUAGE=pt
FIDUS_COUNTRY=GB

# Convide e ganhe: quem convida ganha 10% na próxima cobrança (sem somar); o convidado ganha 7 dias grátis.
# Com 1, um código de convite de cliente vale como convite mesmo com o cadastro fechado (máx. 10 contas
# novas por código por dia). Deixe 0 enquanto o acesso for só por convite seu.
FIDUS_REFERRAL_SIGNUP=0
FIDUS_REFERRAL_PERCENT=10
FIDUS_REFERRAL_TRIAL_DAYS=7
# Link para baixar o app (aparece na página do convite). Vazio até o app estar na loja.
FIDUS_APP_DOWNLOAD_URL=

# Assinaturas pela Google Play / App Store / Stripe (RevenueCat). Segredo que a RevenueCat manda no
# cabeçalho Authorization do aviso (webhook) para https://SEU-DOMINIO/billing/revenuecat. Vazio = desligado.
FIDUS_BILLING_WEBHOOK_SECRET=
# Chaves PÚBLICAS do SDK da RevenueCat (Project settings > API keys). Vazio = botão de assinar mostra "em breve".
FIDUS_REVENUECAT_ANDROID_KEY=
FIDUS_REVENUECAT_IOS_KEY=

# E-mails do Fidus para os clientes (código de entrada, boas-vindas, assinatura, convite aceito), pelo Resend
# (resend.com, grátis até 3 mil/mês). O domínio do remetente precisa estar verificado lá. Vazio = não manda.
FIDUS_RESEND_API_KEY=
FIDUS_EMAIL_FROM=
